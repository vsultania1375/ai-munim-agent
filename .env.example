# Copy to .env (local) or /opt/aimunim/bot.env (server). Never commit real values.

# --- Meta WhatsApp Cloud API ---
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_APP_SECRET=
WA_APP_ID=
WA_VERIFY_TOKEN=
WA_GRAPH_API_VERSION=v25.0

# --- Models ---
ANTHROPIC_API_KEY=
JEV_API_KEY=                     # optional: TypeSafe Jev turn resolver
MUNIM_V2_MODEL=claude-haiku-5-5
MUNIM_V2_EFFORT=low

# --- ERPNext (leave ERPNEXT_URL empty to run on the in-memory demo ERP) ---
ERPNEXT_URL=                     # e.g. http://frontend:8080 inside the compose network
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_COMPANY=AI Munim Demo Traders

# --- Tenancy / routing ---
MUNIM_V2_TESTERS=                # comma-separated numbers that skip onboarding (e.g. 9198XXXXXXXX)
MUNIM_V2_ALLOWED_SENDERS=        # optional allowlist; empty = anyone
MUNIM_V2_POOL_DIR=/app/pool      # pre-created ERPNext sites (infra/make_pool.sh)
MUNIM_PUBLIC_DOMAIN=aimunim.duckdns.org

# ERP -> WhatsApp automation
MUNIM_SUMMARY=on                  # daily morning summary to owners (inside WhatsApp's 24 h window)
MUNIM_SUMMARY_HOUR=9              # IST; sent between this hour and +3 h, else skipped that day
MUNIM_TEMPLATE_NUDGE=             # optional Meta-approved utility template (no parameters) used outside the 24 h window
MUNIM_TEMPLATE_LANG=en
MUNIM_INTERNAL_URL=http://aimunim-bot-1:8800   # where ERPNext webhooks reach the bot (docker network)

# Razorpay payment links (built, OFF until you turn it on)
# Razorpay: nothing here. Each business connects its own account on the portal (owner -> 'online payment chalu karo').
