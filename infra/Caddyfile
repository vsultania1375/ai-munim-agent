{
	# Certificates for business subdomains are issued on first visit, only if the bot
	# confirms the host belongs to a real (claimed) ERPNext site.
	on_demand_tls {
		ask http://bot:8800/caddy/ask
	}
}

aimunim.duckdns.org {
	encode gzip
	# webhook, health and the web portal are all served by the bot
	reverse_proxy bot:8800
}

# Web ERP: demo.<domain> -> shared demo site, <site>.<domain> -> that business's site.
https://demo.aimunim.duckdns.org {
	tls {
		on_demand
	}
	encode gzip
	# ERP sign-in page -> portal (verify on WhatsApp instead). ?manual=1 keeps the password form for other devices.
	@erplogin {
		path /login
		not query manual=1
	}
	redir @erplogin https://aimunim.duckdns.org/?from=erp 302
	handle /munim-sso* {
		reverse_proxy bot:8800
	}
	handle {
		reverse_proxy frontend:8080 {
			header_up Host frontend
		}
	}
}

https://*.aimunim.duckdns.org {
	tls {
		on_demand
	}
	encode gzip
	# one-tap sign-in is answered by the bot on the ERP's own host so cookies land there
	# ERP sign-in page -> portal (verify on WhatsApp instead). ?manual=1 keeps the password form for other devices.
	@erplogin {
		path /login
		not query manual=1
	}
	redir @erplogin https://aimunim.duckdns.org/?from=erp 302
	handle /munim-sso* {
		reverse_proxy bot:8800
	}
	handle {
		reverse_proxy frontend:8080 {
			header_up Host {labels.3}
		}
	}
}
